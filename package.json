{
  "name": "rc600-editor",
  "version": "0.1.0",
  "description": "Boss RC-600 web memory/system editor (RC0 files + Web MIDI)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"npm run api\" \"npm run ui\"",
    "api": "tsx server/index.ts",
    "ui": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "license:create": "tsx server/create-license.ts",
    "test": "tsx --test src/**/*.test.ts web/src/**/*.test.ts server/**/*.test.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@iconify/react": "^6.0.2",
    "@iconify/types": "^2.0.0",
    "fflate": "^0.8.2",
    "hono": "^4.13.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/webmidi": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "license": "MIT"
}
