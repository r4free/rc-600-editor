# Server-side only. Copy the VG-800 editor's OPENAI_API_KEY value here.
# Never expose an LLM key through a VITE_* variable.
OPENAI_API_KEY=
# RC600_LLM_API_KEY=
# VG800_LLM_API_KEY=
# GEMINI_API_KEY=

# Optional provider overrides. With no override, sk-* selects OpenAI and AIza* selects Gemini.
# RC600_LLM_BASE_URL=
# RC600_LLM_MODEL=

# Same production quota defaults as the VG-800 editor.
# AI_LIMIT_ENABLED=1
# AI_LIMIT_PER_IP_MINUTE=3
# AI_LIMIT_PER_IP_DAY=5
# AI_LIMIT_GLOBAL_DAY=60
# AI_LIMIT_EXEMPT_LOCALHOST=1
