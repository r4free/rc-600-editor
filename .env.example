# Server-side only. Copy the VG-800 editor's OPENAI_API_KEY value here.
# Never expose an LLM key through a VITE_* variable.
OPENAI_API_KEY=
# RC600_LLM_API_KEY=
# VG800_LLM_API_KEY=
# GEMINI_API_KEY=

# Optional provider overrides. With no override, sk-* selects OpenAI and AIza* selects Gemini.
# RC600_LLM_BASE_URL=
# RC600_LLM_MODEL=

# Ask for a license key before the editor loads. Use 1 locally to try the activation page.
# RC600_REQUIRE_LICENSE=1

# Stripe secret for the account that owns the payment link. Server only.
# After payment, Stripe should redirect to:
# https://rc-600-editor.onrender.com/api/license/paid?session_id={CHECKOUT_SESSION_ID}
# STRIPE_SECRET_KEY=
# RC600_STRIPE_AMOUNT_CENTS=3900
# RC600_LICENSE_DAYS=3650

# Same production quota defaults as the VG-800 editor.
# AI_LIMIT_ENABLED=1
# AI_LIMIT_PER_IP_MINUTE=3
# AI_LIMIT_PER_IP_DAY=5
# AI_LIMIT_GLOBAL_DAY=60
# AI_LIMIT_EXEMPT_LOCALHOST=1
